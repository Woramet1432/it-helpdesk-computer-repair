# ====================================================================
# IT Helpdesk & Computer Repair System - Environment Configuration
# ====================================================================

# Port for the application (Vite frontend + Express REST API)
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
# When configured, the backend will connect to your PostgreSQL instance.
# If omitted or unavailable, the backend automatically uses its robust embedded database engine.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/it_helpdesk_db

# Alternative individual PostgreSQL connection parameters:
# PGUSER=postgres
# PGPASSWORD=your_secure_password
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=it_helpdesk_db

# Session & Token Secret for HMAC-SHA256 signature
SESSION_SECRET=it-helpdesk-jwt-secret-key-change-this-in-production

# Uploads directory (relative or absolute path)
UPLOAD_DIR=./uploads

# App base URL
APP_URL=http://localhost:3000
